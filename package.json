{
  "name": "image-s3-upload",
  "version": "5.0.0",
  "type": "module",
  "description": "Upload local and remote images directly to S3-compatible storage in Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "rollup --config rollup.config.js -w",
    "build": "pnpm run check:version && pnpm run typecheck && rollup --config rollup.config.js",
    "check:version": "node scripts/check-version.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json --composite false && tsc --noEmit -p tsconfig.vitest.json",
    "test": "vitest run"
  },
  "keywords": [
    "obsidian.md",
    "s3"
  ],
  "author": "renmu",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/node": "20.17.6",
    "@types/path-browserify": "^1.0.3",
    "jsdom": "^25.0.1",
    "obsidian": "^1.7.2",
    "path-browserify": "^1.0.1",
    "rollup": "^4.27.3",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
}
