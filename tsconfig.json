{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "es2020",
    "downlevelIteration": true,
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "skipLibCheck": true,
    "lib": ["dom", "es5", "scripthost", "es2015", "es2020", "ESNext"]
  },
  "include": ["src/**/*.ts"]
}
